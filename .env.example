# Copy to .env (never commit .env). Everything below is optional:
# without a key the app still works with the built-in offline agent.

# --- LLM for the AI agent (any OpenAI-compatible provider) ---
# Free option: create a free key at https://console.groq.com (check the console for current free-tier limits
# and model names, they change over time).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Other OpenAI-compatible examples (uncomment one set):
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1                       LLM_MODEL=gpt-4o-mini
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1                    LLM_MODEL=<a model ending in :free>
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1                       LLM_MODEL=llama3.2   (LLM_API_KEY=ollama)

LLM_TIMEOUT=25

# --- Frontend -> backend ---
# Local default is http://localhost:8000. On Streamlit Cloud, set this in the app's Secrets instead.
BACKEND_URL=http://localhost:8000

# Optional: comma-separated list of allowed browser origins for the API (default: *)
# CORS_ORIGINS=https://your-app.streamlit.app
